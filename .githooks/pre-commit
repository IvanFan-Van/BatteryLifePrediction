#!/usr/bin/env bash
set -euo pipefail

# 进入项目根目录
cd "$(git rev-parse --show-toplevel)"

# 获取本次 Commit 暂存的 Python 文件
files=()
while IFS= read -r -d '' file; do
    case "$file" in
        *.py|*.pyi) files+=("./$file") ;;
    esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ ${#files[@]} -eq 0 ]; then
    echo "No staged Python files. Skipping."
    exit 0
fi


# Pyright Type Checking
echo "Running Pyright on ${#files[@]} files..."
uv run --locked pyright "${files[@]}"

# Ruff Lint
echo "Running Ruff lint on ${#files[@]} files..."
uv run --locked ruff check "${files[@]}"

echo "All checks passed!"